# ==============================================================================
# Open Source Personalized Medicine & Supplement Recommendation Platform
# Environment Configuration (.env.example)
# ==============================================================================

# Database Connection URL:
# - Leave commented out for local development / testing using SQLite (sqlite:///./app.db)
# - For Supabase / PostgreSQL deployment, supply your connection string:
# DATABASE_URL=postgresql+psycopg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# JWT Secret Key: Must be at least 32 characters long for cryptographic security (HS256)
# Generate in PowerShell: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=super-secret-key-change-me-at-least-32-bytes-long-for-hs256

# Knowledge Base Data Directory:
# - 'data': Default original knowledge base (unverified candidates; tests rule R000 safety withholding)
# - 'data_verified': Curated verified knowledge base (with NIH ODS citations; demonstrates full scoring & ranking)
DATA_DIR=data

# Static Frontend Distribution Directory:
# Used when FastAPI serves the compiled React single page application in production
FRONTEND_DIR=frontend/dist

